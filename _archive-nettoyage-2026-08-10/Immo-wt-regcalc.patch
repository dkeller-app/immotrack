+// Occupation d'un logement sur la période — délègue à la source unique.
+// v15.x FIX-DEPART-OCCUPATION : le partant est clippé à sa date de sortie DÉCLARÉE
+// (avant : compté jusqu'au terme du bail → sur-facturé jusqu'à 100 %). La vacance → bailleur.
+// dateSortie injectée sur le bail COURANT sans toucher _getAllBailsForLog (13 autres
+// consommateurs veulent la fin contractuelle).
+function _ccLogOccupations(log, periodFrom, periodTo) {
+  const bails = (typeof _getAllBailsForLog === 'function') ? _getAllBailsForLog(log.ref) : [];
+  const cur = (typeof _findBailByRefTolerant === 'function') ? _findBailByRefTolerant(log.ref) : null;
+  // FIX-AUDIT #1 : même contrat que _finEffOccupation (dateSortie top-level OU depart.dateSortie),
+  // sinon le chemin compteur ne clipperait pas un départ posé en top-level → partant sur-facturé eau/chauffage.
+  const ds = cur && (cur.dateSortie || (cur.depart && cur.depart.dateSortie));
+  if (ds) {
+    const b = bails.find(x => x._type === 'current');
+    if (b) b.dateSortie = ds;
+  }
+  return _logOccupationSegments(bails, periodFrom, periodTo);
+}
